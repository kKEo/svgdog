{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svgdog.example/schema/config-1.json",
  "title": "svgdog.toml",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "profile": {
      "enum": [
        "minimal",
        "docs",
        "strict"
      ],
      "default": "docs"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "render_width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 720,
          "description": "px the diagram is shown at; drives size rules"
        },
        "backgrounds": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "default": [
            "light",
            "dark"
          ],
          "description": "Page backgrounds: light, dark or a colour"
        }
      }
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fonts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "theme": {
          "type": "string",
          "description": "Theme for diagrams that do not name one: a built-in name such as paper or docs-auto, or a theme folder relative to this file"
        },
        "palette": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Allowed colours; empty leaves the palette rule idle"
        },
        "stroke_widths": {
          "type": "array",
          "items": {
            "type": "number"
          }
        },
        "grid": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      }
    },
    "rules": {
      "$ref": "#/$defs/rules"
    },
    "overrides": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "files",
          "rules"
        ],
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Globs relative to the config file"
          },
          "rules": {
            "$ref": "#/$defs/rules"
          }
        }
      }
    }
  },
  "$defs": {
    "rule": {
      "oneOf": [
        {
          "enum": [
            "off",
            "info",
            "warning",
            "error"
          ]
        },
        {
          "type": "object",
          "properties": {
            "severity": {
              "enum": [
                "off",
                "info",
                "warning",
                "error"
              ]
            }
          },
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        }
      ]
    },
    "rules": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "xml-well-formed": {
          "$ref": "#/$defs/rule"
        },
        "svg-root": {
          "$ref": "#/$defs/rule"
        },
        "unknown-element": {
          "$ref": "#/$defs/rule"
        },
        "unknown-attribute": {
          "$ref": "#/$defs/rule"
        },
        "duplicate-id": {
          "$ref": "#/$defs/rule"
        },
        "dangling-reference": {
          "$ref": "#/$defs/rule"
        },
        "viewbox-missing": {
          "$ref": "#/$defs/rule"
        },
        "invalid-path-data": {
          "$ref": "#/$defs/rule"
        },
        "invalid-value": {
          "$ref": "#/$defs/rule"
        },
        "unused-def": {
          "$ref": "#/$defs/rule"
        },
        "text-overflow": {
          "$ref": "#/$defs/rule"
        },
        "text-overlap": {
          "$ref": "#/$defs/rule"
        },
        "shape-overlap": {
          "$ref": "#/$defs/rule"
        },
        "content-clipped": {
          "$ref": "#/$defs/rule"
        },
        "excess-margin": {
          "$ref": "#/$defs/rule"
        },
        "edge-detached": {
          "$ref": "#/$defs/rule"
        },
        "edge-through-node": {
          "$ref": "#/$defs/rule"
        },
        "label-on-line": {
          "$ref": "#/$defs/rule"
        },
        "font-too-small": {
          "$ref": "#/$defs/rule"
        },
        "stroke-too-thin": {
          "$ref": "#/$defs/rule"
        },
        "tight-spacing": {
          "$ref": "#/$defs/rule"
        },
        "off-grid": {
          "$ref": "#/$defs/rule"
        },
        "script-content": {
          "$ref": "#/$defs/rule"
        },
        "external-resource": {
          "$ref": "#/$defs/rule"
        },
        "foreign-object": {
          "$ref": "#/$defs/rule"
        },
        "animation": {
          "$ref": "#/$defs/rule"
        },
        "font-not-portable": {
          "$ref": "#/$defs/rule"
        },
        "css-unsupported": {
          "$ref": "#/$defs/rule"
        },
        "fixed-size": {
          "$ref": "#/$defs/rule"
        },
        "file-too-large": {
          "$ref": "#/$defs/rule"
        },
        "embedded-raster": {
          "$ref": "#/$defs/rule"
        },
        "editor-metadata": {
          "$ref": "#/$defs/rule"
        },
        "title-missing": {
          "$ref": "#/$defs/rule"
        },
        "desc-missing": {
          "$ref": "#/$defs/rule"
        },
        "low-contrast": {
          "$ref": "#/$defs/rule"
        },
        "background-missing": {
          "$ref": "#/$defs/rule"
        },
        "palette": {
          "$ref": "#/$defs/rule"
        },
        "stroke-width-style": {
          "$ref": "#/$defs/rule"
        }
      }
    }
  }
}
