{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svgdog.example/schema/findings-1.json",
  "title": "svgdog result envelope",
  "type": "object",
  "required": [
    "tool",
    "version",
    "command",
    "ok"
  ],
  "properties": {
    "tool": {
      "const": "svgdog"
    },
    "version": {
      "type": "string"
    },
    "command": {
      "type": "string"
    },
    "ok": {
      "type": "boolean"
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "files",
        "errors",
        "warnings",
        "info",
        "fixable",
        "truncated"
      ],
      "properties": {
        "files": {
          "type": "integer",
          "minimum": 0
        },
        "errors": {
          "type": "integer",
          "minimum": 0
        },
        "warnings": {
          "type": "integer",
          "minimum": 0
        },
        "info": {
          "type": "integer",
          "minimum": 0
        },
        "fixable": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "outputs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "bytes"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "error": {
      "$ref": "#/$defs/error"
    },
    "changed": {
      "type": "boolean",
      "description": "edit, fix: whether the text changed"
    },
    "dry_run": {
      "type": "boolean"
    },
    "diff": {
      "type": "string",
      "description": "edit, fix: unified diff of the change; empty when nothing changed"
    },
    "diff_truncated": {
      "type": "boolean"
    },
    "operations": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "given",
        "applied"
      ],
      "properties": {
        "given": {
          "type": "integer"
        },
        "applied": {
          "type": "integer"
        }
      }
    },
    "fixed": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "rule",
          "count"
        ],
        "properties": {
          "rule": {
            "type": "string"
          },
          "count": {
            "type": "integer"
          }
        }
      }
    },
    "validated": {
      "type": "boolean",
      "description": "false when the command skipped the checks"
    },
    "svg": {
      "type": "string",
      "description": "render as a tool call without an output path: the drawing itself"
    },
    "checked": {
      "type": "integer",
      "description": "render --check: how many files were compared"
    },
    "stale": {
      "type": "array",
      "description": "render --check and docs --check: what is missing or out of date; ok is false when it is not empty",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "reason"],
        "properties": {
          "path": { "type": "string" },
          "reason": { "enum": ["missing", "differs", "image links differ"] }
        }
      }
    },
    "documents": {
      "type": "array",
      "description": "docs: the pages that hold diagrams",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "diagrams"],
        "properties": {
          "path": { "type": "string" },
          "diagrams": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "width",
        "height",
        "scale",
        "region",
        "background",
        "annotated"
      ],
      "description": "preview: the PNG that was made",
      "properties": {
        "width": {
          "type": "integer",
          "maximum": 2000
        },
        "height": {
          "type": "integer",
          "maximum": 4000
        },
        "scale": {
          "type": "number",
          "description": "Output pixels per viewBox unit"
        },
        "region": {
          "$ref": "#/$defs/bbox",
          "description": "The part of the viewBox shown"
        },
        "background": {
          "enum": [
            "light",
            "dark"
          ]
        },
        "annotated": {
          "type": "integer",
          "description": "Finding boxes outlined on the image"
        }
      }
    },
    "formatting": {
      "enum": [
        "preserved",
        "rewritten"
      ],
      "description": "edit on a spec: whether comments and layout were kept, or the spec was rewritten in canonical form"
    }
  },
  "oneOf": [
    {
      "required": [
        "summary",
        "findings",
        "outputs"
      ],
      "not": {
        "required": [
          "error"
        ]
      }
    },
    {
      "required": [
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        }
      },
      "not": {
        "required": [
          "findings"
        ]
      }
    }
  ],
  "$defs": {
    "bbox": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "items": false,
      "minItems": 4
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "severity",
        "file",
        "target",
        "line",
        "message"
      ],
      "properties": {
        "rule": {
          "type": "string",
          "description": "Stable rule id from the catalogue"
        },
        "severity": {
          "enum": [
            "error",
            "warning",
            "info"
          ]
        },
        "file": {
          "type": "string",
          "description": "Path as given on the command line"
        },
        "target": {
          "type": "string",
          "description": "Selector for the element; an id where one exists"
        },
        "line": {
          "type": "integer",
          "minimum": 1,
          "description": "1-based line of the element's start tag"
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "message": {
          "type": "string"
        },
        "measured": {
          "type": "object",
          "description": "Numbers behind the message; approximate: true marks a heuristic measurement"
        },
        "fix": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "safe",
            "ops"
          ],
          "description": "Autofix in the edit --ops format",
          "properties": {
            "safe": {
              "type": "boolean",
              "description": "True when fix applies it without --unsafe"
            },
            "ops": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "required": [
                  "op",
                  "target"
                ]
              }
            }
          }
        }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ],
      "properties": {
        "code": {
          "type": "string"
        },
        "message": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "suggestion": {
          "type": "string"
        }
      }
    }
  }
}
