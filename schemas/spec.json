{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://svgdoc.example/schema/spec-1.json",
  "title": "svgdoc diagram spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "diagram", "title", "nodes"],
  "properties": {
    "version": { "const": 1 },
    "diagram": { "enum": ["flow", "layers", "sequence", "free"] },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "description": { "type": "string", "maxLength": 500 },
    "direction": { "enum": ["right", "down"], "default": "right" },
    "theme": { "type": "string", "default": "docs-light" },
    "max_width": { "type": "integer", "minimum": 200, "maximum": 2000, "default": 960 },
    "nodes": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "groups": { "type": "array", "items": { "$ref": "#/$defs/group" } },
    "notes": { "type": "array", "items": { "$ref": "#/$defs/note" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$" },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "minLength": 1, "maxLength": 80 },
        "kind": {
          "enum": ["box", "service", "client", "datastore", "queue",
                   "actor", "external", "decision", "document"],
          "default": "box"
        },
        "emphasis": { "type": "boolean", "default": false },
        "width": { "type": "number", "minimum": 40 },
        "at": {
          "type": "array",
          "prefixItems": [{ "type": "number" }, { "type": "number" }],
          "items": false,
          "minItems": 2
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from", "to"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "from": { "$ref": "#/$defs/id" },
        "to": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "maxLength": 40 },
        "style": { "enum": ["sync", "async", "dependency"], "default": "sync" },
        "arrow": { "enum": ["end", "both", "none"], "default": "end" }
      }
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "members"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "label": { "type": "string", "maxLength": 60 },
        "members": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attach", "text"],
      "properties": {
        "attach": { "$ref": "#/$defs/id" },
        "text": { "type": "string", "minLength": 1, "maxLength": 120 },
        "side": { "enum": ["top", "right", "bottom", "left"], "default": "right" }
      }
    }
  }
}
